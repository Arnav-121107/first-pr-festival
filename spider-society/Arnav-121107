<!--
  SPIDER-ID CARD — Arnav-121107
-->
<div
  class="spider-card"
  data-name="Arnav Kothawade"
  data-alias="Spideyy"
  data-github="Arnav-121107"
  data-suit="#c0203a"
>
  <style>
    /* ── Suit starts here ──────────────────────────────── */
    .spider-card {
      --suit: #c0203a;      /* red */
      --suit-blue: #1f4287; /* bluish accent */
      --ink: #06060a;

      width: 320px;
      height: 440px;
      box-sizing: border-box;
      padding: 22px;
      font-family: system-ui, sans-serif;
      color: #e8e6e3;
      background: radial-gradient(circle at 30% 0%, #1a0a12, var(--ink) 70%);
      border: 2px solid var(--suit);
      border-radius: 18px;
      overflow: hidden;
      position: relative;
    }

    /* Webbing, drawn with two repeating gradients, tinted red + blue */
    .spider-card::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: repeating-linear-gradient(
          45deg,
          rgba(192, 32, 58, 0.08) 0 1px,
          transparent 1px 14px
        ),
        repeating-linear-gradient(-45deg, rgba(31, 66, 135, 0.10) 0 1px, transparent 1px 14px);
      pointer-events: none;
    }

    /* subtle circuit-like accent glow in the corner, nods to the mech legs */
    .spider-card::after {
      content: "";
      position: absolute;
      top: -60px;
      right: -60px;
      width: 180px;
      height: 180px;
      background: radial-gradient(circle, rgba(31, 66, 135, 0.22), transparent 65%);
      pointer-events: none;
    }

    /* The actual spider web, fanning from the top-right corner */
    .web-bg {
      position: absolute;
      inset: 0;
      pointer-events: none;
    }

    .web-bg svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    @keyframes strand-pulse {
      0%, 100% { opacity: 0.3; }
      50% { opacity: 0.85; }
    }

    .pulse-strand {
      animation: strand-pulse 3.2s ease-in-out infinite;
    }

    /* Halftone dot grain, ties the illustrated web to the photo's gritty texture */
    .halftone {
      position: absolute;
      inset: 0;
      pointer-events: none;
      opacity: 0.5;
      mix-blend-mode: overlay;
      background-image: radial-gradient(circle, rgba(0, 0, 0, 0.9) 1px, transparent 1.4px);
      background-size: 5px 5px;
    }

    .avatar {
      width: 88px;
      height: 88px;
      border: 2px solid var(--suit);
      box-shadow: 0 0 22px rgba(192, 32, 58, 0.5), 0 0 30px rgba(31, 66, 135, 0.3);
      position: relative;
      z-index: 1;
      overflow: hidden;
      background: radial-gradient(circle at 35% 30%, var(--suit) 0%, #7a1526 55%, var(--ink) 100%);
      /* torn/jagged mask silhouette instead of a clean rounded rect */
      clip-path: polygon(
        12% 0%, 40% 4%, 62% 0%, 88% 6%, 100% 18%,
        96% 40%, 100% 60%, 92% 78%, 100% 92%,
        78% 100%, 55% 94%, 34% 100%, 10% 92%,
        14% 70%, 0% 55%, 8% 32%, 0% 12%
      );
    }

    .avatar svg,
    .avatar img {
      width: 100%;
      height: 100%;
      display: block;
      object-fit: cover;
    }

    .alias {
      margin: 16px 0 0;
      font-size: 32px;
      font-weight: 800;
      line-height: 1;
      letter-spacing: 0.5px;
      background: linear-gradient(90deg, var(--suit), var(--suit-blue));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      text-transform: uppercase;
      position: relative;
      z-index: 1;
    }

    .tagline {
      margin: 6px 0 10px;
      font-family: ui-monospace, monospace;
      font-size: 9px;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      color: var(--suit);
      opacity: 0.7;
      position: relative;
      z-index: 1;
    }

    .meta {
      position: relative;
      z-index: 1;
      line-height: 1.35;
    }

    .name {
      margin: 0;
      font-size: 13px;
      opacity: 0.75;
    }

    .handle {
      margin: 0;
      font-family: ui-monospace, monospace;
      font-size: 11px;
      opacity: 0.5;
    }

    .stats {
      position: relative;
      z-index: 1;
      margin-top: 14px;
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .stat-row {
      display: flex;
      align-items: center;
      gap: 8px;
      font-family: ui-monospace, monospace;
      font-size: 9px;
      letter-spacing: 0.5px;
      text-transform: uppercase;
      opacity: 0.85;
    }

    .stat-label {
      width: 56px;
      flex-shrink: 0;
      opacity: 0.65;
    }

    .stat-track {
      flex: 1;
      height: 4px;
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.08);
      overflow: hidden;
    }

    .stat-fill {
      height: 100%;
      border-radius: 999px;
      background: var(--suit);
    }

    .stat-fill.blue {
      background: var(--suit-blue);
    }

    .skills {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 12px;
      padding: 0;
      list-style: none;
      position: relative;
      z-index: 1;
    }

    .skills li {
      padding: 4px 9px;
      font-size: 10px;
      border: 1px solid var(--suit);
      border-radius: 999px;
      background: rgba(192, 32, 58, 0.12);
    }

    .skills li:nth-child(even) {
      border-color: var(--suit-blue);
      background: rgba(31, 66, 135, 0.1);
      opacity: 0.85;
    }

    .footer {
      position: absolute;
      left: 22px;
      right: 22px;
      bottom: 18px;
      display: flex;
      justify-content: space-between;
      font-family: ui-monospace, monospace;
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      opacity: 0.5;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      padding-top: 10px;
      z-index: 1;
    }
  </style>

  <div class="web-bg">
    <svg viewBox="0 0 320 440" xmlns="http://www.w3.org/2000/svg">
      <g fill="none" stroke-width="1.3">
        <!-- spokes, fanning from the top-right corner -->
        <path class="pulse-strand" d="M270,20 L320,0" stroke="#c0203a" opacity="0.5" />
        <path d="M270,20 L320,90" stroke="#1f4287" opacity="0.45" />
        <path d="M270,20 L320,180" stroke="#c0203a" opacity="0.4" />
        <path d="M270,20 L250,440" stroke="#1f4287" opacity="0.35" />
        <path d="M270,20 L120,440" stroke="#c0203a" opacity="0.35" />
        <path d="M270,20 L0,300" stroke="#1f4287" opacity="0.4" />
        <path d="M270,20 L0,120" stroke="#c0203a" opacity="0.45" />
        <path d="M270,20 L60,0" stroke="#1f4287" opacity="0.5" />
        <path d="M270,20 L180,0" stroke="#c0203a" opacity="0.5" />
        <!-- concentric rings connecting the spokes -->
        <polyline points="282.5,15 282.5,37.5 282.5,60 265,125 232.5,125 202.5,90 202.5,45 217.5,15 247.5,15"
                  stroke="#0a0a0c" opacity="0.55" />
        <polyline points="295,10 295,55 295,100 260,230 195,230 135,160 135,70 165,10 225,10"
                  stroke="#1f4287" opacity="0.4" />
        <polyline points="307.5,5 307.5,72.5 307.5,140 255,335 157.5,335 67.5,230 67.5,95 112.5,5 202.5,5"
                  stroke="#c0203a" opacity="0.3" />
      </g>
      <circle cx="270" cy="20" r="3" fill="#0a0a0c" opacity="0.6" />
    </svg>
  </div>

  <div class="halftone"></div>

  <div class="avatar" title="Spideyy">
    <img src="data:image/jpeg;base64," alt="Spideyy" />
  </div>

  <h1 class="alias">Spideyy</h1>
  <p class="tagline">Friendly Neighborhood // Mech-Arachnid</p>

  <div class="meta">
    <p class="name">Arnav Kothawade</p>
    <p class="handle">@Arnav-121107</p>
  </div>

  <div class="stats">
    <div class="stat-row">
      <span class="stat-label">Web-Sling</span>
      <span class="stat-track"><span class="stat-fill" style="width: 88%"></span></span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Tech</span>
      <span class="stat-track"><span class="stat-fill blue" style="width: 78%"></span></span>
    </div>
    <div class="stat-row">
      <span class="stat-label">Agility</span>
      <span class="stat-track"><span class="stat-fill" style="width: 92%"></span></span>
    </div>
  </div>

  <ul class="skills">
    <li>Web-Shooters</li>
    <li>Thermal Insulation</li>
    <li>Mech Spider-Legs</li>
    <li>Gauntlet Missiles</li>
    <li>Nav / Mapping HUD</li>
  </ul>

  <div class="footer">
    <span>Spider-Society</span>
    <span>Earth-1610</span>
  </div>

</div>